+
+void
+linux_rcu_read_unlock(unsigned type)
+{
+    MPASS(type < RCU_TYPE_MAX);
+    if (RCU_SKIP())
+        return;
+    struct task_struct *ts = current;
+    struct linux_epoch_record *record = &linux_epoch_record[type];
