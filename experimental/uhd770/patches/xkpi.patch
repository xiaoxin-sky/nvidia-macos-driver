+/*
+ * One-display DRM/IOFramebuffer snapshot ABI, shared by the C bridge and IOKit.
+ * Mode IDs are positive, stable for a framebuffer lifetime and never reassigned
+ * after unplug. Only progressive, validated modes inside the immutable scanout
+ * allocation can be advertised. EDID is copied; no DRM pointer crosses the ABI.
+ * Changing limits/layout requires both boundary copies and host fixtures to move
+ * together. This describes display output, not Metal or GPU command execution.
+ */
+#ifndef NMX_DISPLAY_PROTOCOL_H
+#define NMX_DISPLAY_PROTOCOL_H
+#include <stdint.h>
+#include <string.h>
+#define NMX_DISPLAY_MODES 64u
+#define NMX_DISPLAY_EDID_BYTES 4096u
+#define NMX_MODE_PREFERRED 1u
+#define NMX_MODE_HSYNC_POSITIVE 2u
+#define NMX_MODE_VSYNC_POSITIVE 4u
+struct nmx_display_mode {
+    uint32_t id, width, height, pclk_khz;
+    uint32_t htotal, vtotal, hsync_start, hsync_end, vsync_start, vsync_end;
+    uint32_t flags;
+};
+struct nmx_display_state {
+    uint64_t generation;
+    uint32_t connected, mode_count, current_mode, edid_size;
+    int32_t error;
+    struct nmx_display_mode modes[NMX_DISPLAY_MODES];
+    uint8_t edid[NMX_DISPLAY_EDID_BYTES];
+};
+
+/* Validate timings before they reach Apple timing arithmetic or fixed scanout. */
+static inline int nmx_display_mode_valid(const struct nmx_display_mode *mode,
+                                         uint32_t width, uint32_t height)
+{
+    uint64_t pixels, milli_hz;
+    if (!mode || !mode->id || !mode->width || !mode->height || !mode->pclk_khz ||
+        mode->width > width || mode->height > height ||
+        mode->width > mode->hsync_start || mode->hsync_start >= mode->hsync_end ||
+        mode->hsync_end > mode->htotal || mode->height > mode->vsync_start ||
+        mode->vsync_start >= mode->vsync_end || mode->vsync_end > mode->vtotal)
+        return 0;
+    pixels = (uint64_t)mode->htotal * mode->vtotal;
+    milli_hz = (uint64_t)mode->pclk_khz * 1000000u / pixels;
+    return milli_hz >= 20000 && milli_hz <= 500000;
+}
+
+static inline const struct nmx_display_mode *nmx_display_find(
+    const struct nmx_display_state *state, uint32_t id)
+{
+    if (!state || !id || state->mode_count > NMX_DISPLAY_MODES) return 0;
+    for (uint32_t i = 0; i < state->mode_count; i++)
+        if (state->modes[i].id == id) return &state->modes[i];
+    return 0;
+}
+
+/* Require complete, checksummed EDID including declared extension blocks.
+ * Truncated/oversized blobs are unavailable rather than silently rewritten. */
+static inline uint32_t nmx_display_edid_size(const void *bytes, uint64_t size)
+{
+    static const uint8_t header[8] = {0,255,255,255,255,255,255,0};
+    const uint8_t *data = (const uint8_t *)bytes;
+    uint32_t length;
+    if (!data || size < 128 || memcmp(data, header, sizeof(header))) return 0;
+    length = ((uint32_t)data[126] + 1) * 128u;
+    if (length > size || length > NMX_DISPLAY_EDID_BYTES) return 0;
+    for (uint32_t block = 0; block < length; block += 128) {
+        unsigned sum = 0;
+        for (unsigned i = 0; i < 128; i++) sum += data[block + i];
+        if (sum & 255u) return 0;
+    }
+    return length;
+}
+
+/* DDC uses one-based 128-byte blocks; preserve output on invalid requests. */
+static inline int nmx_display_edid_block(const struct nmx_display_state *state,
+                                         uint32_t block, void *out, uint64_t capacity)
+{
+    if (!state || !state->connected || !out || !block || capacity < 128 ||
+        state->edid_size > NMX_DISPLAY_EDID_BYTES || block > state->edid_size / 128)
+        return 0;
+    memcpy(out, state->edid + (block - 1) * 128u, 128);
+    return 1;
+}
+#endif
