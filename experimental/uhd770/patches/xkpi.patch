+/*
+ * Serialize attach completion, stop requests and power-operation admission.
+ * The owning service supplies its live IOLock. Hardware calls run outside the
+ * lock, but stop must wait for busy() to become false before freeing the device.
+ * Cancellation is cooperative at attach phase boundaries; a hardware probe is
+ * never timed out and freed while its thread is still using the device.
+ */
+#ifndef NMX_ATTACH_LIFECYCLE_H
+#define NMX_ATTACH_LIFECYCLE_H
+class NmxAttachLifecycle {
+    IOLock *fLock = nullptr;
+    int fStatus = 0;
+    unsigned fPowerCalls = 0;
+    bool fStopping = false;
+    bool fDetached = false;
+public:
+    void initialize(IOLock *lock) { fLock = lock; }
+    bool stopping() {
+        if (!fLock) return true;
+        IOLockLock(fLock);
+        bool result = fStopping;
+        IOLockUnlock(fLock);
+        return result;
+    }
+    void requestStop() {
+        IOLockLock(fLock);
+        fStopping = true;
+        IOLockUnlock(fLock);
+    }
+    void complete(int status) {
+        IOLockLock(fLock);
+        fStatus = status;
+        IOLockUnlock(fLock);
+    }
+    bool busy() {
+        IOLockLock(fLock);
+        bool result = fStatus == 0 || fPowerCalls != 0;
+        IOLockUnlock(fLock);
+        return result;
+    }
+    bool enterPower() {
+        if (!fLock) return false;
+        IOLockLock(fLock);
+        bool result = fStatus == 1 && !fStopping && !fDetached;
+        if (result) fPowerCalls++;
+        IOLockUnlock(fLock);
+        return result;
+    }
+    bool beginDetach() {
+        IOLockLock(fLock);
+        bool result = fStopping && fStatus != 0 && !fPowerCalls && !fDetached;
+        if (result) fDetached = true;
+        IOLockUnlock(fLock);
+        return result;
+    }
+    bool enterShutdown() {
+        IOLockLock(fLock);
+        bool result = fStopping && fStatus != 0 && !fPowerCalls && !fDetached;
+        if (result) fPowerCalls++;
+        IOLockUnlock(fLock);
+        return result;
+    }
+    void leavePower() {
+        IOLockLock(fLock);
+        if (fPowerCalls) fPowerCalls--;
+        IOLockUnlock(fLock);
+    }
+};
+#endif
