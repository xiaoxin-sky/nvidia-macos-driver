+        return nullptr;
+    OSDictionary *match = IOService::serviceMatching("IOPCIDevice");
+    if (match == nullptr)
+        return nullptr;
+    OSIterator *it = IOService::getMatchingServices(match);
+    match->release();
+    if (it == nullptr)
+        return nullptr;
+    IOPCIDevice *found = nullptr;
+    bool past = after == nullptr;
+    while (OSObject *o = it->getNextObject()) {
+        IOPCIDevice *d = OSDynamicCast(IOPCIDevice, o);
+        if (!past) {
+            past = d == after;
+            continue;
+        }
+        /* PCI configuration class and subclass bytes, not a cached GPU list. */
+        if (d != nullptr && d->configRead8(0x0b) == cls &&
+            (subclass < 0 || d->configRead8(0x0a) == subclass)) {
+            found = d;
+            break;
+        }
+    }
+    it->release();
+    return found;
+}
 
