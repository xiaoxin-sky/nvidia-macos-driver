+    if (!dev || !out || !id) return EINVAL;
+    memset(out, 0, sizeof(*out));
+    mutex_lock(&fbs_mutex);
+    for (int i = 0; i < MAX_FB; i++) {
+        struct nmx_fb *fb = fbs[i].fb;
+        struct drm_mode_set *ms, *selected = NULL;
+        struct drm_display_mode *old, *replacement;
+        unsigned connectors = 0;
+        int rollback;
+        if (fbs[i].dev != dev || !fb || !fb->published || READ_ONCE(fb->closed)) continue;
+        mutex_lock(&fb->operation_mutex);
+        if (!fb->activated) { ret = -EAGAIN; goto done; }
+        if (!fb->display.connected || fb->display.error) { ret = -ENXIO; goto done; }
+        if (!nmx_display_find(&fb->display, id) || id > fb->catalog_count) { ret = -EINVAL; goto done; }
+        if (fb->display.current_mode == id) { ret = 0; goto done; }
+        mutex_lock(&fb->client.modeset_mutex);
+        drm_client_for_each_modeset(ms, &fb->client) {
+            if (!ms->mode || !ms->num_connectors) continue;
+            selected = ms;
+            connectors += ms->num_connectors;
+        }
+        if (connectors != 1 || !selected) {
+            mutex_unlock(&fb->client.modeset_mutex);
+            ret = -EOPNOTSUPP;
+            goto done;
+        }
+        replacement = drm_mode_duplicate(fb->client.dev, fb->catalog[id - 1]);
+        if (!replacement) {
+            mutex_unlock(&fb->client.modeset_mutex);
+            ret = -ENOMEM;
+            goto done;
+        }
+        old = selected->mode;
+        selected->mode = replacement;
+        mutex_unlock(&fb->client.modeset_mutex);
+        nmx_gpu_stage_record("fb.switch.check.before", (int)id);
+        ret = drm_client_modeset_check(&fb->client);
+        nmx_gpu_stage_record("fb.switch.check.after", ret);
+        if (!ret) {
