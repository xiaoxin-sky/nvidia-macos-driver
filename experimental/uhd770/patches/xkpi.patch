+
+extern "C" void nmx_gpu_stage_record(const char *stage, int result)
+{
+    if (stage == nullptr || g_lock == nullptr)
+        return;
+    IOLockLock(g_lock);
+    unsigned sequence = ++g_nmx_stage_sequence;
+    IOService *owner = g_nmx_stage_owner;
+    if (owner != nullptr)
+        owner->retain();
+    IOLockUnlock(g_lock);
+    char value[160];
+    snprintf(value, sizeof(value), "memstage-v2 seq=%u %s ret=%d", sequence, stage, result);
+    if (owner != nullptr) {
+        owner->setProperty("nmxdiag-stage", value);
+        owner->release();
+    }
+    IOLog("NullMoth trace: %s\n", value);
+}
