+/* Checked inclusive DMA ranges and page-aligned IOKit mapping spans. These
+ * helpers only validate arithmetic; callers still own the memory and enforce
+ * device address masks. IOKit spans may not wrap their exclusive end at 2^64. */
+#ifndef NMX_CHECKED_RANGES_H
+#define NMX_CHECKED_RANGES_H
+#include <stdint.h>
+
+static inline int nmx_checked_last(uint64_t start, uint64_t length, uint64_t *last)
+{
+    if (!last || !length || length - 1 > UINT64_MAX - start) return 0;
+    *last = start + length - 1;
+    return 1;
+}
+
+static inline int nmx_checked_page_span(uint64_t start, uint64_t length, uint64_t page_size,
+                                      uint64_t *base, uint64_t *span)
+{
+    uint64_t last, mask, end;
+    if (!base || !span || !page_size || (page_size & (page_size - 1)) ||
+        !nmx_checked_last(start, length, &last)) return 0;
+    mask = page_size - 1;
+    end = last | mask;
+    if (end == UINT64_MAX) return 0;
+    *base = start & ~mask;
+    *span = end - *base + 1;
+    return 1;
+}
+#endif
