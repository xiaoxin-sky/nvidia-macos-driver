+	/* wait for callbacks to complete */
+	taskqueue_drain(linux_irq_work_tq, &head->task);
+}
+
+void
+linux_call_rcu(unsigned type, struct rcu_head *context, rcu_callback_t func)
+{
+	struct callback_head *rcu;
+	struct linux_epoch_head *head;
