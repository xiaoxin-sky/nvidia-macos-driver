+     * sched_bind/priority walk is unavailable here. Sleep outside every spin
+     * lock so readers and interrupt/IPI handlers can make forward progress. */
+    pause("nmxrcu", 1);
+}
+
+void
+linux_synchronize_rcu(unsigned type)
+{
+    MPASS(type < RCU_TYPE_MAX);
+    if (RCU_SKIP())
+        return;
+    if (nmx_in_critical() || current->rcu_recurse[type] != 0)
