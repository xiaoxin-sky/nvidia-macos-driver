+/*
+ * Callback lifetime for the software IOFramebuffer interrupt source. The caller
+ * supplies IOKit/thread declarations and owns the lock and timer. Callback code
+ * runs without this lock. Unregister prevents new calls and waits for another
+ * thread's in-flight call before returning; self-unregister never waits on itself.
+ * Targets are borrowed while installed and retained for each dispatched call.
+ * Stop must precede timer cancellation/drain, and drain must precede lock freeing.
+ * The same implementation is compiled into the host concurrency fixture.
+ */
+#ifndef NMX_FB_INTERRUPTS_H
+#define NMX_FB_INTERRUPTS_H
+
+class NmxFbInterrupts {
+    struct Slot {
+        IOFBInterruptProc proc = nullptr;
+        OSObject *target = nullptr;
+        void *ref = nullptr;
+        bool enabled = false;
+        bool active = false;
+        unsigned removing = 0;
+        thread_t running = THREAD_NULL;
+    };
+    IOLock *fLock = nullptr;
+    Slot fVbl, fConnect;
+    bool fStopping = false;
+
+    Slot *lookup(void *reference) {
+        if (reference == &fVbl) return &fVbl;
+        if (reference == &fConnect) return &fConnect;
+        return nullptr;
+    }
+
+public:
+    struct Call {
+        IOFBInterruptProc proc = nullptr;
+        OSObject *target = nullptr;
+        void *ref = nullptr;
+        void *slot = nullptr;
+    };
+
+    void initialize(IOLock *lock) { fLock = lock; }
+
+    IOReturn install(IOSelect type, IOFBInterruptProc proc, OSObject *target,
+                     void *ref, void **reference) {
+        if (!reference || !proc || !fLock) return kIOReturnBadArgument;
+        *reference = nullptr;
+        Slot *slot = type == kIOFBVBLInterruptType ? &fVbl :
+                     type == kIOFBConnectInterruptType ? &fConnect : nullptr;
+        if (!slot) return kIOReturnUnsupported;
+        IOLockLock(fLock);
+        IOReturn ret = kIOReturnSuccess;
+        if (fStopping) ret = kIOReturnNotReady;
+        else if (slot->proc || slot->active || slot->removing) ret = kIOReturnExclusiveAccess;
+        else {
+            slot->proc = proc;
+            slot->target = target;
+            slot->ref = ref;
+            slot->enabled = true;
+            *reference = slot;
+        }
+        IOLockUnlock(fLock);
+        return ret;
+    }
+
+    IOReturn remove(void *reference) {
+        Slot *slot = lookup(reference);
+        if (!slot || !fLock) return kIOReturnBadArgument;
+        IOLockLock(fLock);
+        slot->removing++;
+        slot->enabled = false;
+        slot->proc = nullptr;
+        slot->target = nullptr;
+        slot->ref = nullptr;
+        while (slot->active && slot->running != current_thread())
+            IOLockSleep(fLock, slot, THREAD_UNINT);
+        slot->removing--;
+        IOLockUnlock(fLock);
+        return kIOReturnSuccess;
+    }
+
+    IOReturn setState(void *reference, UInt32 state) {
+        Slot *slot = lookup(reference);
+        if (!slot || !fLock) return kIOReturnBadArgument;
+        IOLockLock(fLock);
+        IOReturn ret = slot->proc ? kIOReturnSuccess : kIOReturnBadArgument;
+        if (slot->proc) slot->enabled = state != 0 && !fStopping;
+        IOLockUnlock(fLock);
+        return ret;
+    }
+
+    bool begin(IOSelect type, Call &call) {
+        Slot *slot = type == kIOFBVBLInterruptType ? &fVbl :
+                     type == kIOFBConnectInterruptType ? &fConnect : nullptr;
+        if (!slot) return false;
+        IOLockLock(fLock);
+        bool ready = !fStopping && slot->enabled && slot->proc && !slot->active;
+        if (ready) {
+            slot->active = true;
+            slot->running = current_thread();
+            call = {slot->proc, slot->target, slot->ref, slot};
+            if (call.target) call.target->retain();
+        }
+        IOLockUnlock(fLock);
+        return ready;
+    }
+    bool beginVbl(Call &call) { return begin(kIOFBVBLInterruptType, call); }
+    bool beginConnect(Call &call) { return begin(kIOFBConnectInterruptType, call); }
+
+    void end(Call &call) {
+        Slot *slot = lookup(call.slot);
+        if (!slot) return;
+        IOLockLock(fLock);
+        slot->active = false;
+        slot->running = THREAD_NULL;
+        IOLockWakeup(fLock, slot, false);
+        IOLockUnlock(fLock);
+        if (call.target) call.target->release();
+        call = {};
+    }
+
+    void stop() {
+        if (!fLock) return;
+        IOLockLock(fLock);
+        fStopping = true;
+        fVbl.enabled = fConnect.enabled = false;
+        IOLockUnlock(fLock);
+    }
+
+    void arm(thread_call_t timer, uint64_t deadline) {
+        IOLockLock(fLock);
+        if (!fStopping) thread_call_enter_delayed(timer, deadline);
+        IOLockUnlock(fLock);
+    }
+};
+#endif
