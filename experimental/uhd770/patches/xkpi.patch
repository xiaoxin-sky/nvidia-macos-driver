+
+void
+linux_synchronize_rcu(unsigned type)
+{
+    MPASS(type < RCU_TYPE_MAX);
+    if (RCU_SKIP())
+        return;
+    if (nmx_in_critical() || current->rcu_recurse[type] != 0)
