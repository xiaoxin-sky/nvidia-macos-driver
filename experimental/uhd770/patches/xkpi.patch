--- /dev/null
+++ b/override/i915/nmx_i915_scanout.c
@@ -0,0 +1,122 @@
+/*
+ * Alder Lake-S diagnostic scan-out mapping for the NullMoth display bridge.
+ * Reuse i915's framebuffer GGTT pinning and CPU aperture mapping, as fbdev does.
+ * Shmem pages need not be physically adjacent: the GGTT aperture is contiguous.
+ * The cookie owns the display VMA pin/reference, iomap pin, and an awake reference
+ * until unmap. Keeping the GPU awake is intentional for this initial display test;
+ * this does not establish sleep/wake or Metal support. Return positive errno to
+ * match nmx_fb_open; outputs/cookie are assigned only after complete success.
+ */
+#include <linux/err.h>
+#include <linux/slab.h>
+#include <drm/drm_framebuffer.h>
+#include "gem/i915_gem_object.h"
+#include "gt/intel_gt.h"
+#include "i915_drv.h"
+#include "i915_gem_gtt.h"
+#include "i915_vma.h"
+#include "display/intel_display_types.h"
+#include "display/intel_fb.h"
+#include "display/intel_fb_pin.h"
+#include "nmx_port.h"
+
+extern void nmx_gpu_stage_record(const char *, int);
+
+struct nmx_i915_scanout {
+    struct drm_i915_private *i915;
+    struct i915_vma *vma;
+    unsigned long flags;
+    intel_wakeref_t wakeref;
+    bool iomap_pinned;
+};
+
+void nmx_i915_scanout_unmap(void *cookie)
+{
+    struct nmx_i915_scanout *ctx = cookie;
+
+    if (!ctx)
+        return;
+    if (ctx->iomap_pinned)
+        i915_vma_unpin_iomap(ctx->vma);
+    if (ctx->vma)
+        intel_fb_unpin_vma(ctx->vma, ctx->flags);
+    intel_runtime_pm_put(&ctx->i915->runtime_pm, ctx->wakeref);
+    kfree(ctx);
+}
+
+int nmx_i915_scanout_map(struct drm_framebuffer *fb,
+                         struct nmx_fb_info *info, void **cookie)
+{
+    const struct i915_gtt_view view = { .type = I915_GTT_VIEW_NORMAL };
+    struct nmx_i915_scanout *ctx;
+    struct drm_i915_private *i915;
+    struct i915_ggtt *ggtt;
+    void __iomem *vaddr;
+    u64 used, length, offset, aperture;
+    int ret;
+
+    if (!fb || !fb->dev || !info || !cookie)
+        return EINVAL;
+    *cookie = NULL;
+    i915 = to_i915(fb->dev);
+    if (!IS_ALDERLAKE_S(i915))
+        return EOPNOTSUPP;
+    used = (u64)fb->pitches[0] * fb->height;
+    length = PAGE_ALIGN(used);
+    if (!used || length < used)
+        return EINVAL;
+
+    ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+    if (!ctx)
+        return ENOMEM;
+    ctx->i915 = i915;
+    ctx->wakeref = intel_runtime_pm_get(&i915->runtime_pm);
+    nmx_gpu_stage_record("igtt.pin.before", 0);
+    ctx->vma = nmx_intel_fb_pin_mappable(fb, &view,
+        to_intel_framebuffer(fb)->min_alignment, 0, false, &ctx->flags);
+    if (IS_ERR(ctx->vma)) {
+        ret = PTR_ERR(ctx->vma);
+        ctx->vma = NULL;
+        nmx_gpu_stage_record("igtt.pin.after", ret);
+        goto fail;
+    }
+    nmx_gpu_stage_record("igtt.pin.after", 0);
+
+    ggtt = to_gt(i915)->ggtt;
+    offset = i915_ggtt_offset(ctx->vma);
+    aperture = resource_size(&ggtt->gmadr);
+    if (!i915_vma_is_map_and_fenceable(ctx->vma) ||
+        length > i915_vma_size(ctx->vma) || offset > aperture ||
+        length > aperture - offset) {
+        ret = -ENOSPC;
+        nmx_gpu_stage_record("igtt.aperture", ret);
+        goto fail;
+    }
+    nmx_gpu_stage_record("igtt.aperture", 0);
+
+    nmx_gpu_stage_record("igtt.lock.before", 0);
+    ret = i915_gem_object_lock(ctx->vma->obj, NULL);
+    nmx_gpu_stage_record("igtt.lock.after", ret);
+    if (ret)
+        goto fail;
+    nmx_gpu_stage_record("igtt.iomap.before", 0);
+    vaddr = i915_vma_pin_iomap(ctx->vma);
+    i915_gem_object_unlock(ctx->vma->obj);
+    if (IS_ERR_OR_NULL(vaddr)) {
+        ret = vaddr ? PTR_ERR(vaddr) : -ENOMEM;
+        nmx_gpu_stage_record("igtt.iomap.after", ret);
+        goto fail;
+    }
+    ctx->iomap_pinned = true;
+    nmx_gpu_stage_record("igtt.iomap.after", 0);
+
+    info->phys = ggtt->gmadr.start + offset;
+    info->size = length;
+    info->kva = (u64)(uintptr_t)vaddr;
+    *cookie = ctx;
+    return 0;
+
+fail:
+    nmx_i915_scanout_unmap(ctx);
+    return -ret;
+}
