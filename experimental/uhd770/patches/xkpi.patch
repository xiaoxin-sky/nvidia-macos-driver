+/*
+ * Normalize IOFramebuffer's packed 1/3-channel 8/16-bit gamma tables to the
+ * pinned i915 legacy gamma ABI (256 unsigned 16-bit entries per channel).
+ * The kernel caller must already own a buffer of channels*count*(bits/8) bytes;
+ * this helper validates metadata, never probes user pointers and has no I/O.
+ * Keep the size in sync with nmx_drm_gamma_set and the bridge's channel offsets.
+ */
+#ifndef NMX_GAMMA_LUT_H
+#define NMX_GAMMA_LUT_H
+#include <stdint.h>
+#include <string.h>
+#define NMX_GAMMA_ENTRIES 256u
+
+static inline int nmx_gamma_valid(unsigned channels, unsigned count, unsigned bits)
+{
+    return (channels == 1 || channels == 3) && count >= 2 && count <= 65536 &&
+        (bits == 8 || bits == 16);
+}
+
+static inline uint16_t nmx_gamma_sample(const uint8_t *data, unsigned index, unsigned bits)
+{
+    uint16_t value;
+    if (bits == 8) return (uint16_t)(data[index] * 257u);
+    memcpy(&value, data + index * 2u, sizeof(value));
+    return value;
+}
+
+static inline int nmx_gamma_normalize(unsigned channels, unsigned count, unsigned bits,
+                                    const void *data, uint16_t *output)
+{
+    if (!data || !output || !nmx_gamma_valid(channels, count, bits))
+        return 0;
+    for (unsigned channel = 0; channel < 3; channel++) {
+        const uint8_t *source = (const uint8_t *)data +
+            (channels == 1 ? 0 : channel * count * (bits / 8));
+        for (unsigned i = 0; i < NMX_GAMMA_ENTRIES; i++) {
+            uint32_t position = i * (count - 1);
+            unsigned index = position / (NMX_GAMMA_ENTRIES - 1);
+            unsigned fraction = position % (NMX_GAMMA_ENTRIES - 1);
+            unsigned next = index + (index + 1 < count);
+            uint32_t a = nmx_gamma_sample(source, index, bits);
+            uint32_t b = nmx_gamma_sample(source, next, bits);
+            const unsigned scale = NMX_GAMMA_ENTRIES - 1;
+            output[channel * NMX_GAMMA_ENTRIES + i] = (uint16_t)
+                ((a * (scale - fraction) + b * fraction + scale / 2) / scale);
+        }
+    }
+    return 1;
+}
+#endif
