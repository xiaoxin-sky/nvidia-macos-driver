+/* Diagnostic build for one UHD 770: publish stages in RAM and IOLog only.
+ * No checkpoint calls NVRAM or sync. The original attach guard stays unchanged.
+ * g_lock protects the owner and sequence; it is released before property/log I/O.
+ * The attach thread/IOKit owns the service, and stop clears the borrowed owner.
+ */
+static IOService *g_nmx_stage_owner;
+static unsigned g_nmx_stage_sequence;
+
+static void nmx_diag_set_owner(IOService *owner)
+{
+    IOLockLock(g_lock);
+    g_nmx_stage_owner = owner;
+    IOLockUnlock(g_lock);
+}
+
+extern "C" void nmx_gpu_stage_record(const char *stage, int result)
+{
+    if (stage == nullptr || g_lock == nullptr)
+        return;
+    IOLockLock(g_lock);
+    unsigned sequence = ++g_nmx_stage_sequence;
+    IOService *owner = g_nmx_stage_owner;
+    if (owner != nullptr)
+        owner->retain();
+    IOLockUnlock(g_lock);
