static bool enable_breadcrumb(dma_fence *f) { return i915_request_enable_breadcrumb(container_of(f,i915_request,fence)); }
static const dma_fence_ops completion_ops{enable_breadcrumb,nullptr,nullptr};
static bool hardware_irq_enable(intel_breadcrumbs *) { return true; }
static void hardware_irq_disable(intel_breadcrumbs *) {}
static std::atomic<unsigned> irq_runs{0};
static void counted_breadcrumb(irq_work *w) { ++irq_runs;signal_irq_work(w); }
struct Fixture {
    taskqueue *queue;
    workqueue_model wq;
    std::thread worker;
    engine_scheduler scheduler{};
    intel_engine_cs engine{};
    irq_driver_boundary irq_driver{};
    intel_gt gt{};
    intel_breadcrumbs bread{};
    intel_context context{};
    i915_request request{};
    drm_syncobj sync{};
    u32 hwsp=0;
    explicit Fixture(uint32_t target=17)
    {
        queue=new taskqueue{};mtx_init(&queue->tq_mutex);STAILQ_INIT(&queue->tq_queue);
        queue->tq_alive=1;queue->tq_tcount=1;queue->tq_enqueue=taskqueue_thread_enqueue;
        queue->tq_context=&queue;wq.taskqueue=queue;system_wq=&wq;
        engine.breadcrumbs=&bread;engine.sched_engine=&scheduler;engine.gt=&engine;
        engine.irq_handler=execlists_irq_handler;gt.i915=&irq_driver;gt.engine_class[RENDER_CLASS][0]=&engine;
        mtx_init(&bread.signalers_lock);mtx_init(&bread.irq_lock);INIT_LIST_HEAD(&bread.signalers);
        bread.irq_engine=&engine;bread.irq_enable=hardware_irq_enable;bread.irq_disable=hardware_irq_disable;
        init_irq_work(&bread.irq_work,counted_breadcrumb);
        mtx_init(&context.signal_lock);INIT_LIST_HEAD(&context.signals);INIT_LIST_HEAD(&context.signal_link);
        mtx_init(&request.lock);dma_fence_init(&request.fence,&completion_ops,&request.lock,1,target);
        request.context=&context;request.engine=&engine;request.hwsp_seqno=&hwsp;INIT_LIST_HEAD(&request.signal_link);
        set_bit(I915_FENCE_FLAG_ACTIVE,&request.fence.flags);
        mtx_init(&sync.lock);sync.fence=&request.fence;INIT_LIST_HEAD(&sync.cb_list);
        worker=std::thread([&] {cpu_id=13;taskqueue_thread_loop(queue,0);});
    }
    void hardware_complete(uint32_t value)
    {
        WRITE_ONCE(hwsp,value);gen11_gt_identity_handler(&gt,(RENDER_CLASS<<16)|GT_RENDER_USER_INTERRUPT);
    }
    int64_t wait(int64_t ticks,uint32_t flags=0)
    {
        drm_syncobj *s[]={&sync};uint32_t index=UINT32_MAX;
        int64_t result=drm_syncobj_array_wait_timeout(s,nullptr,1,flags,ticks,&index,nullptr);
        if(result>0 && !(flags&DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL))assert(index==0);return result;
    }
    void cleanup(bool completed)
    {
        irq_work_sync(&bread.irq_work);
        if(!completed && test_bit(I915_FENCE_FLAG_SIGNAL,&request.fence.flags)) {
            // Producers are quiesced; finish the hardware model to drain the
            // real driver reference, never to turn a failed wait into a pass.
            hardware_complete(static_cast<uint32_t>(request.fence.seqno));irq_work_sync(&bread.irq_work);
        }
        bread.active=0;irq_work_queue(&bread.irq_work);irq_work_sync(&bread.irq_work);
        assert(request.refs==1 && request.fence.refcount.refs==1 && context.refs==1);
        assert(!bread.signaler_active && !bread.irq_armed && list_empty(&context.signals) && list_empty(&bread.signalers));
        taskqueue_free(queue);worker.join();
        mtx_destroy(&sync.lock);mtx_destroy(&request.lock);mtx_destroy(&context.signal_lock);
        mtx_destroy(&bread.irq_lock);mtx_destroy(&bread.signalers_lock);system_wq=nullptr;
        assert(!wait_allocations);std::lock_guard<std::mutex> g(wait_lock);assert(waiters.empty());
    }
};
template<class F> static void until(F f)
{
    const auto end=Clock::now()+std::chrono::seconds(3);
    while(!f()){assert(Clock::now()<end);std::this_thread::yield();}
}
static bool task_wait_registered(task_struct *t)
{
    std::lock_guard<std::mutex> g(wait_lock);
    return std::any_of(waiters.begin(),waiters.end(),[&](Wait *w){return w->channel==t && w->result==THREAD_WAITING;});
}
static void wake_before_block(Fixture &f,uint32_t seqno)
{
    // A native wait is already registered at this point. Trigger the other
    // worker and observe its wake; do not nest another kernel-style wait on
    // this same thread while it already owns a Mach wait registration.
    f.hardware_complete(seqno);
    until([] {std::lock_guard<std::mutex> g(wait_lock);return wait_record.result==THREAD_AWAKENED;});
}
static void after_sleep_completion()
{
    Fixture f;task_struct *target=current;unsigned before=irq_runs;
    std::thread producer([&]{cpu_id=7;until([&]{return task_wait_registered(target);});f.hardware_complete(17);});
    auto result=f.wait(1000);producer.join();assert(result>0 && irq_runs>before);
    assert(test_bit(DMA_FENCE_FLAG_SIGNALED_BIT,&f.request.fence.flags));f.cleanup(true);
}
static void early_completion()
{
    Fixture f;before_native_block=[&]{wake_before_block(f,17);};
    assert(f.wait(1000)>0);assert(!before_native_block);f.cleanup(true);
}
static void no_premature_completion()
{
    Fixture f;f.hardware_complete(16);irq_work_sync(&f.bread.irq_work);
    assert(f.wait(8)==-ETIME);assert(!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT,&f.request.fence.flags));
    assert(!wait_allocations);f.cleanup(false);
}
static void status_wraparound()
{
    Fixture f(0xfffffffeU);WRITE_ONCE(f.hwsp,0xfffffff0U);
    before_native_block=[&]{wake_before_block(f,1);};
    assert(f.wait(1000)>0);f.cleanup(true);
}
static void completed_before_wait()
{
    Fixture f;f.hardware_complete(17);irq_work_sync(&f.bread.irq_work);
    assert(f.wait(1000)>0);f.cleanup(true);
}
static void interrupted_wait()
{
    Fixture f;immediate_result=THREAD_INTERRUPTED;
    auto result=f.wait(1000);immediate_result=THREAD_WAITING;current->saved_signal=0;
    assert(result==-ERESTARTSYS);assert(!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT,&f.request.fence.flags));f.cleanup(false);
}
static void engine_irq_selection()
{
    Fixture f;task_struct *target=current;
    std::thread producer([&] {
        cpu_id=7;until([&]{return task_wait_registered(target);});
        irq_work_sync(&f.bread.irq_work);
        WRITE_ONCE(f.hwsp,17U);
        gen11_gt_identity_handler(&f.gt,(RENDER_CLASS<<16)|(1U<<20)|GT_RENDER_USER_INTERRUPT);
        gen11_gt_identity_handler(&f.gt,(RENDER_CLASS<<16));
        irq_work_sync(&f.bread.irq_work);
        assert(!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT,&f.request.fence.flags));
        gen11_gt_identity_handler(&f.gt,(RENDER_CLASS<<16)|GT_RENDER_USER_INTERRUPT);
    });
    assert(f.wait(1000)>0);producer.join();f.cleanup(true);
}
static void repeated_irq_delivery()
{
    Fixture f;task_struct *target=current;
    std::thread producer([&] {
        cpu_id=7;until([&]{return task_wait_registered(target);});
        for(unsigned n=0;n<12;++n)f.hardware_complete(17);
    });
    assert(f.wait(1000)>0);producer.join();irq_work_sync(&f.bread.irq_work);
    assert(f.request.refs==1 && f.context.refs==1 && f.request.fence.refcount.refs==1);f.cleanup(true);
}
static void sequential_requests_same_context()
{
    Fixture f;task_struct *target=current;
    for(uint32_t seqno=17;seqno<20;++seqno) {
        if(seqno!=17) {
            irq_work_sync(&f.bread.irq_work);assert(f.request.refs==1 && f.request.fence.refcount.refs==1);
            dma_fence_init(&f.request.fence,&completion_ops,&f.request.lock,1,seqno);
            set_bit(I915_FENCE_FLAG_ACTIVE,&f.request.fence.flags);
        }
        std::thread producer([&] {cpu_id=7;until([&]{return task_wait_registered(target);});f.hardware_complete(seqno);});
        assert(f.wait(1000)>0);producer.join();irq_work_sync(&f.bread.irq_work);
        assert(f.context.refs==1 && list_empty(&f.context.signals) && f.request.fence.refcount.refs==1);
    }
    f.cleanup(true);
}
static void wait_all_single_fence()
{
    Fixture f;task_struct *target=current;
    std::thread producer([&]{cpu_id=7;until([&]{return task_wait_registered(target);});f.hardware_complete(17);});
    assert(f.wait(1000,DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL)>0);producer.join();f.cleanup(true);
}
static void wait_allocation_failures()
{
    for(unsigned fail:{1U,2U}) {
        Fixture f;wait_allocation_index=0;wait_fail_allocation=fail;
        assert(f.wait(1000)==-ENOMEM);wait_fail_allocation=0;
        assert(!wait_allocations && !test_bit(DMA_FENCE_FLAG_SIGNALED_BIT,&f.request.fence.flags));f.cleanup(false);
    }
}
int main()
{
    std::setvbuf(stdout,nullptr,_IONBF,0);assert(nmx_sleepq_init()==0);
    const std::pair<const char *,void(*)()> cases[]={
        {"HWSP-irqwork-queue-breadcrumb-fence-syncobj-native-sleep",after_sleep_completion},
        {"registered-before-block completion",early_completion},
        {"older-HWSP cannot signal; real timeout and cleanup",no_premature_completion},
        {"HWSP sequence wraparound",status_wraparound},
        {"completion before callback attachment",completed_before_wait},
        {"native interruption preserves incomplete fence",interrupted_wait},
        {"actual GT identity and execlists IRQ engine selection",engine_irq_selection},
        {"repeated IRQ cannot duplicate callback/ownership",repeated_irq_delivery},
        {"sequential requests reuse context with balanced references",sequential_requests_same_context},
        {"WAIT_ALL ordinary fence completion",wait_all_single_fence},
        {"syncobj wait allocation failures release prior storage",wait_allocation_failures}};
    for(auto &test:cases){test.second();std::printf("PASS %s\n",test.first);}
    nmx_sleepq_fini();
    std::puts("Actual queue/irqwork/i915-breadcrumb/fence/syncobj/Linux/native-sleep contracts passed; hardware/native primitive/RCU storage boundaries modeled; no GPU executed.");
}
