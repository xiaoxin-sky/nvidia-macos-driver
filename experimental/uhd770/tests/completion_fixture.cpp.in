#define DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL 1U
#define DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT 2U
#define DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE 4U
#define GFP_KERNEL 0
static std::atomic<unsigned> wait_allocations{0};
static thread_local unsigned wait_allocation_index=0,wait_fail_allocation=0;
static void *completion_alloc(size_t n,size_t size)
{
    if(++wait_allocation_index==wait_fail_allocation)return nullptr;
    void *p=std::calloc(n,size);if(p)++wait_allocations;return p;
}
static void completion_free(void *p) { if(p){assert(wait_allocations);--wait_allocations;std::free(p);} }
#define kmalloc_array(n,s,flags) completion_alloc((n),(s))
#define kcalloc(n,s,flags) completion_alloc((n),(s))
#define kfree(p) completion_free(p)
