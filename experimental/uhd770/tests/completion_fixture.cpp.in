/* ACTUAL_QUEUE_IRQWORK */
static void completion_queue_free(taskqueue *q) { assert(!q->tq_alive && !q->tq_active);delete q; }

// READ/WRITE_ONCE and atomic bit operations are native model primitives. Their
// shared lock prevents C++ data races in the injected hardware/status storage.
static std::mutex once_lock;
template<class T> static T once_read(const T *p) { std::lock_guard<std::mutex> g(once_lock);return *p; }
template<class T,class U> static void once_write(T *p,U v) { std::lock_guard<std::mutex> g(once_lock);*p=static_cast<T>(v); }
#define READ_ONCE(v) once_read(&(v))
#define WRITE_ONCE(v,x) once_write(&(v),(x))
#ifdef NULL
#undef NULL
#endif
#define NULL nullptr
#define typeof(x) decltype(x)
#define __user
#define __rcu
#define container_of(p,t,m) reinterpret_cast<std::remove_reference_t<t> *>(reinterpret_cast<char *>(p)-offsetof(std::remove_reference_t<t>,m))
struct list_head { list_head *next,*prev; };
// RCU list storage is modeled with atomic snapshots under this primitive
// mutex; it does not serialize the actual driver callbacks/queue algorithms.
static std::recursive_mutex list_lock;
static list_head *list_next(const list_head *p) { std::lock_guard<std::recursive_mutex> g(list_lock);return p->next; }
static list_head *list_prev(const list_head *p) { std::lock_guard<std::recursive_mutex> g(list_lock);return p->prev; }
static void INIT_LIST_HEAD(list_head *p) { std::lock_guard<std::recursive_mutex> g(list_lock);p->next=p->prev=p; }
static bool list_empty(const list_head *p) { return list_next(p)==p; }
static void __list_add(list_head *p,list_head *prev,list_head *next) { next->prev=p;p->next=next;p->prev=prev;prev->next=p; }
static void list_add(list_head *p,list_head *head) { std::lock_guard<std::recursive_mutex> g(list_lock);__list_add(p,head,head->next); }
static void list_add_tail(list_head *p,list_head *head) { std::lock_guard<std::recursive_mutex> g(list_lock);__list_add(p,head->prev,head); }
static void list_del(list_head *p) { std::lock_guard<std::recursive_mutex> g(list_lock);p->next->prev=p->prev;p->prev->next=p->next; }
static void list_del_init(list_head *p) { std::lock_guard<std::recursive_mutex> g(list_lock);list_del(p);INIT_LIST_HEAD(p); }
static void list_replace(list_head *old,list_head *p) { std::lock_guard<std::recursive_mutex> g(list_lock);p->next=old->next;p->next->prev=p;p->prev=old->prev;p->prev->next=p; }
#define list_add_rcu(p,h) list_add((p),(h))
#define list_del_rcu(p) list_del(p)
#define list_entry(p,t,m) container_of((p),t,m)
#define list_next_entry(p,m) list_entry(list_next(&(p)->m),typeof(*(p)),m)
#define list_prev_entry(p,m) list_entry(list_prev(&(p)->m),typeof(*(p)),m)
#define list_is_last(p,h) (list_next(p)==(h))
#define list_is_first(p,h) (list_prev(p)==(h))
#define list_for_each_prev(p,h) for((p)=list_prev(h);(p)!=(h);(p)=list_prev(p))
template<class T> static T *list_value(list_head *p,const list_head *head,size_t offset)
{
    return p==head?nullptr:reinterpret_cast<T *>(reinterpret_cast<char *>(p)-offset);
}
#define LIST_VALUE(p,h,node,m) list_value<std::remove_pointer_t<decltype(p)>>((node),(h),offsetof(std::remove_pointer_t<decltype(p)>,m))
#define list_for_each_entry_rcu(p,h,m) for((p)=LIST_VALUE(p,h,list_next(h),m);(p);(p)=LIST_VALUE(p,h,list_next(&(p)->m),m))
#define list_for_each_entry_safe(p,n,h,m) for((p)=LIST_VALUE(p,h,list_next(h),m),(n)=nullptr;(p)?((n)=LIST_VALUE(p,h,list_next(&(p)->m),m),true):false;(p)=(n))
struct llist_head { llist_node *first=nullptr;std::mutex lock; };
static bool llist_empty(llist_head *p) { std::lock_guard<std::mutex> g(p->lock);return !p->first; }
static llist_node *llist_del_all(llist_head *p) { std::lock_guard<std::mutex> g(p->lock);auto *head=p->first;p->first=nullptr;return head; }
static bool llist_add(llist_node *n,llist_head *p) { std::lock_guard<std::mutex> g(p->lock);bool empty=!p->first;n->next=p->first;p->first=n;return empty; }
#define llist_entry(p,t,m) container_of((p),t,m)
#define llist_for_each_safe(p,n,head) for((p)=(head),(n)=nullptr;(p)?((n)=(p)->next,true):false;(p)=(n))
using atomic_t=std::atomic<int>;
static void atomic_inc(atomic_t *p) { ++*p; }
static void atomic_dec(atomic_t *p) { --*p; }
static bool test_bit(unsigned bit,const uint64_t *p) { std::lock_guard<std::mutex> g(once_lock);return *p&(1ULL<<bit); }
static void set_bit(unsigned bit,uint64_t *p) { std::lock_guard<std::mutex> g(once_lock);*p|=1ULL<<bit; }
static bool test_and_set_bit(unsigned bit,uint64_t *p) { std::lock_guard<std::mutex> g(once_lock);bool old=*p&(1ULL<<bit);*p|=1ULL<<bit;return old; }
static bool test_and_clear_bit(unsigned bit,uint64_t *p) { std::lock_guard<std::mutex> g(once_lock);bool old=*p&(1ULL<<bit);*p&=~(1ULL<<bit);return old; }
/* ACTUAL_FENCE_FLAGS */
struct kref { std::atomic<unsigned> refs{1}; };
static void kref_init(kref *p) { p->refs=1; }
static void kref_get(kref *p) { assert(p->refs.fetch_add(1)); }
static bool kref_get_unless_zero(kref *p) { unsigned n=p->refs.load();while(n && !p->refs.compare_exchange_weak(n,n+1)){}return n!=0; }
static void kref_put(kref *p,void (*release)(kref *)) { assert(p->refs);if(p->refs.fetch_sub(1)==1)release(p); }
struct dma_fence;
struct dma_fence_cb;
using dma_fence_func_t=void(*)(dma_fence *,dma_fence_cb *);
struct dma_fence_cb { list_head node;dma_fence_func_t func=nullptr; };
struct dma_fence_ops { bool (*enable_signaling)(dma_fence *);bool (*signaled)(dma_fence *);void (*set_deadline)(dma_fence *,ktime_t); };
struct dma_fence { spinlock_t *lock;const dma_fence_ops *ops;kref refcount;uint64_t flags=0,seqno=0,context=0;list_head cb_list;ktime_t timestamp=0;int error=0; };
static void dma_fence_release(kref *) { assert(false && "fixture primary fence ownership was lost"); }
static ktime_t ktime_get() { return static_cast<ktime_t>(mach_absolute_time()); }
int dma_fence_signal_locked(dma_fence *);
bool dma_fence_is_signaled(dma_fence *);
dma_fence *dma_fence_get(dma_fence *);
void dma_fence_put(dma_fence *);
static dma_fence *dma_fence_get_stub() { assert(false && "timeline stub is outside ordinary-fence test scope");return nullptr; }
static int dma_fence_chain_find_seqno(dma_fence **f,uint64_t point) { assert(*f && point==0);return 0; }
#define rcu_dereference(p) READ_ONCE(p)
#define rcu_access_pointer(p) READ_ONCE(p)
#define rcu_pointer_handoff(p) (p)
#define rcu_dereference_protected(p,c) READ_ONCE(p)
#define lockdep_assert_held(p) do {} while(0)
#define lockdep_assert_none_held_once() do {} while(0)
