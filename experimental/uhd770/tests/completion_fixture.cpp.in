/* Joined software completion chain. MMIO/IRQ delivery and HWSP writes are
 * injected at the hardware boundary. Queue, breadcrumb, fence, syncobj and
 * Linux/native wait state machines are actual source. Native primitive locks,
 * RCU/refcount services, allocators and object storage remain host models. */
/* ACTUAL_SLEEP_CHAIN */

using u32=uint32_t;
using u8=uint8_t;
using u16=uint16_t;
using s32=int32_t;
using u64=uint64_t;
using ktime_t=int64_t;
using thread_t=std::thread::id;
using task_fn_t=void(void *,int);
using taskqueue_enqueue_fn=void(*)(void *);
constexpr int TASK_ENQUEUED=1,TASK_NOENQUEUE=2,TASKQUEUE_FAIL_IF_PENDING=1,TASKQUEUE_FAIL_IF_CANCELING=2,TQ_EXITING=1;
struct mtx { struct lock_object lock_object; };
static void mtx_init(mtx *m) { m->lock_object.native=new std::mutex;m->lock_object.held=false; }
static void mtx_lock(mtx *m) { m->lock_object.native->lock();assert(!m->lock_object.held);m->lock_object.held=true; }
static void mtx_unlock(mtx *m) { assert(m->lock_object.held);m->lock_object.held=false;m->lock_object.native->unlock(); }
static void mtx_destroy(mtx *m) { assert(!m->lock_object.held);delete m->lock_object.native;m->lock_object.native=nullptr; }
using spinlock_t=mtx;
#define spin_lock(m) mtx_lock(m)
#define spin_unlock(m) mtx_unlock(m)
#define msleep(chan,m,pri,msg,timo) nmx_sleep((chan),&(m)->lock_object,(pri),(msg),(timo))
#define wakeup(c) nmx_wakeup(c)
#define wakeup_one(c) nmx_wakeup_one(c)
static std::atomic<unsigned> native_worker_exits{0};
static void nmx_thread_exit_cleanup() { ++native_worker_exits; }
static thread_t current_thread() { return std::this_thread::get_id(); }
static void thread_terminate(thread_t) {}
struct taskqueue;
static void completion_queue_free(taskqueue *);
static std::shared_mutex rcu_mutex;
static thread_local unsigned rcu_depth=0;
static void rcu_read_lock() { if(rcu_depth++==0)rcu_mutex.lock_shared(); }
static void rcu_read_unlock() { assert(rcu_depth);if(--rcu_depth==0)rcu_mutex.unlock_shared(); }
static void synchronize_rcu() { assert(!rcu_depth);std::unique_lock<std::shared_mutex> g(rcu_mutex); }
struct workqueue_model { struct taskqueue *taskqueue; };
static workqueue_model *system_wq;
#define LKPI_IRQ_WORK_TQ (system_wq->taskqueue)
#define TASK_INIT(t,p,fn,arg) do { std::memset((t),0,sizeof(*(t)));(t)->ta_priority=(p);(t)->ta_func=(fn);(t)->ta_context=(arg); } while(0)
struct llist_node { llist_node *next; };
