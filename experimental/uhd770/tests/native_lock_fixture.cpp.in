static void other_owner_trylocks()
{
    sx s{};sx_init_flags(&s,"sx-other",0);nmx_sx_xlock(&s);
    std::thread a([&] { require(!nmx_sx_try_xlock(&s) && !nmx_sx_try_slock(&s),"SX trylock stole another thread's exclusive hold"); });a.join();
    require(nmx_sx_xlocked(&s),"SX failed trylock changed owner");nmx_sx_xunlock(&s);sx_destroy(&s);
    rwlock rw{};rw_init_flags(&rw,"rw-other",0);nmx_rw_wlock(&rw);
    std::thread b([&] { require(!nmx_rw_try_wlock(&rw) && !nmx_rw_try_rlock(&rw),"RW trylock stole another writer"); });b.join();
    require(nmx_rw_wowned(&rw),"RW failed trylock changed owner");nmx_rw_wunlock(&rw);rw_destroy(&rw);
}
static void idr_threaded_preload()
{
    require(!nmx_idr_preload_get() && !idr_live_allocations,"IDR preload starts with stale scope");
    idr_allocations=idr_fail_at=0;idr_fail_nowait=false;
    on_idr_allocation=[] { host_cpu^=1; };
    idr_preload(GFP_KERNEL);on_idr_allocation={};
    auto *cache=static_cast<linux_idr_cache *>(nmx_idr_preload_get());
    require(cache && cache->count==MAX_IDR_FREE && irqs && nmx_linux_bh_depth()==1,
        "IDR cache was not reserved in a sleepable native context");
    host_cpu^=1;idr_fail_nowait=true;idr tree{};
    idr_layer *node=idr_get(&tree);
    require(node && node->bitmap==0xffffffffUL && cache->count==MAX_IDR_FREE-1,
        "IDR did not consume its original thread cache after CPU migration");
    idr_preload_end();idr_fail_nowait=false;
    require(!nmx_idr_preload_get() && nmx_linux_bh_depth()==0 && irqs && idr_live_allocations==1,
        "IDR end did not release unused cache outside the native lock");
    host_idr_free(node);require(!idr_live_allocations,"IDR caller-owned reservation freed too early/leaked");
}
static void idr_partial_preload()
{
    idr tree{};idr_allocations=0;idr_fail_at=1;
    idr_preload(GFP_KERNEL);require(!nmx_idr_preload_get() && nmx_linux_bh_depth()==0,"IDR cache allocation failure left active scope");
    idr_preload_end();idr_fail_at=0;
    idr_allocations=0;idr_fail_at=4;idr_preload(GFP_KERNEL);idr_fail_at=0;idr_fail_nowait=true;
    auto *cache=static_cast<linux_idr_cache *>(nmx_idr_preload_get());
    require(cache && cache->count==2,"IDR partial prefill did not retain successful reservations");
    auto *one=idr_get(&tree);auto *two=idr_get(&tree);auto *none=idr_get(&tree);
    require(one && two && !none,"IDR exhausted prefill did not report allocation failure");
    idr_preload_end();idr_fail_nowait=false;host_idr_free(one);host_idr_free(two);
    require(!idr_live_allocations && !nmx_idr_preload_get() && nmx_linux_bh_depth()==0,"partial IDR cache leaked allocations or scope");
}
static void idr_parallel_preloads()
{
    std::vector<std::thread> workers;
    for(int i=0;i<4;++i) workers.emplace_back([] {
        for(int n=0;n<30;++n) {
            idr_preload(GFP_KERNEL);host_cpu^=1;idr_fail_nowait=true;idr tree{};
            auto *node=idr_get(&tree);require(node!=nullptr,"parallel IDR cache lost a reservation");
            idr_preload_end();idr_fail_nowait=false;host_idr_free(node);
            require(nmx_linux_bh_depth()==0 && !nmx_idr_preload_get() && irqs,"parallel IDR thread scope not balanced");
        }
    });for(auto &w:workers)w.join();
    require(!idr_live_allocations,"parallel IDR caches leaked native allocations");
}
int main()
{
    const std::pair<const char *,void(*)()> cases[]={
        {"nested-native-contention",nested_spin_wait},{"BH-migration-and-critical",explicit_bh_migration},
        {"true-critical-guard",true_critical_guard},{"actual-CSB-uncore-fallback",csb_fallback},
        {"parallel-native-owner",concurrent_owner},{"recursion-and-spin",recursion_and_trylock},
        {"BH-bounds",bh_bounds},{"Linux-mutex-owner-probes",linux_mutex_owner_probes},
        {"Linux-rwsem-contention",linux_rwsem_contention},{"native-RW-contention",native_rw_contention},
        {"exclusive-sleep-recursion",exclusive_sleep_recursion},
        {"downgrade-shared-sleep",downgrade_and_shared_sleep},{"other-owner-trylocks",other_owner_trylocks},
        {"IDR-thread-cache-migration",idr_threaded_preload},{"IDR-partial-prefill",idr_partial_preload},
        {"IDR-parallel-preloads",idr_parallel_preloads}};
    for(auto &c:cases) { c.second();std::printf("PASS %s\n",c.first); }
    std::puts("Actual Linux/native locking, IDR/BH/critical/CSB contracts passed; native primitives/allocator/MMIO modeled; no GPU executed.");
}
