/* Actual Linux mutex/rwsem/IDR, native locking and i915 CSB/uncore read code.
 * Native locks, CPU identity, timer and MMIO are controlled host primitives.
 * These checks diagnose illegal blocking contexts; they do not execute a GPU.
 */
#include <atomic>
#include <cassert>
#include <climits>
#include <condition_variable>
#include <cstddef>
#include <cstdint>
#include <cstdio>
