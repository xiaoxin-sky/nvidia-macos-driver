static void downgrade_and_shared_sleep()
{
    rw_semaphore sem{};linux_init_rwsem(&sem,"rwsem-downgrade");down_write(&sem);downgrade_write(&sem);
    require(!nmx_sx_xlocked(&sem.sx) && sem.sx.sx_shared==1,"rwsem downgrade lost shared ownership");
    std::thread second([&] { require(down_read_trylock(&sem),"downgrade prevented another reader");up_read(&sem); });second.join();
    require(!down_write_trylock(&sem) && !nmx_sx_try_upgrade(&sem.sx),"failed SX try-upgrade did not retain original shared hold");
    uintptr_t how=nmx_lock_release(&sem.sx.lock_object);require(how==HOW_SHARED && sem.sx.sx_shared==0,"SX shared sleep release incorrect");
    down_write(&sem);up_write(&sem);nmx_lock_reacquire(&sem.sx.lock_object,how);
    require(sem.sx.sx_shared==1 && !nmx_sx_xlocked(&sem.sx),"SX shared sleep reacquire changed mode");up_read(&sem);sx_destroy(&sem.sx);
    rwlock rw{};rw_init_flags(&rw,"rw-downgrade",0);nmx_rw_wlock(&rw);nmx_rw_downgrade(&rw);
    require(!nmx_rw_wowned(&rw) && rw.rw_readers==1,"native RW downgrade lost shared mode");
    require(!nmx_rw_try_wlock(&rw) && !nmx_rw_try_upgrade(&rw),"native RW failed upgrade dropped shared lock");
    how=nmx_lock_release(&rw.lock_object);require(how==HOW_SHARED && rw.rw_readers==0,"RW shared release wrong");
    nmx_rw_wlock(&rw);nmx_rw_wunlock(&rw);nmx_lock_reacquire(&rw.lock_object,how);
    require(rw.rw_readers==1 && !nmx_rw_wowned(&rw),"RW shared reacquire changed mode");nmx_rw_unlock(&rw);rw_destroy(&rw);
