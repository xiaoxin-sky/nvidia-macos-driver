using spinlock_t=struct mtx;
using gfp_t=unsigned;
#define GFP_KERNEL 1
#define M_WAITOK 1
#define M_NOWAIT 2
#define M_ZERO 4
#define M_IDR 0
#define MPASS(v) KASSERT(v,("IDR invariant"))
#define likely(v) (v)
#define spin_lock_init(m) mtx_init((m),"idr-preload",nullptr,MTX_DEF|MTX_NOWITNESS|MTX_NEW)
#define spin_lock_destroy(m) mtx_destroy(m)
static std::atomic<unsigned> idr_live_allocations{0};
static thread_local unsigned idr_allocations=0,idr_fail_at=0;
static thread_local bool idr_fail_nowait=false;
static thread_local std::function<void()> on_idr_allocation;
static void *host_idr_alloc(size_t size,unsigned flags)
{
    if(!irqs || native_spins) throw std::runtime_error("IDR allocation with native interrupts masked");
    if(flags&M_WAITOK) assert(nmx_linux_bh_depth()==0);
    if(on_idr_allocation) on_idr_allocation();
    if(++idr_allocations==idr_fail_at || ((flags&M_NOWAIT) && idr_fail_nowait)) return nullptr;
    void *p=(flags&M_ZERO)?std::calloc(1,size):std::malloc(size);
    if(p) ++idr_live_allocations;return p;
}
static void host_idr_free(void *p)
{
    if(p) { assert(idr_live_allocations);--idr_live_allocations;std::free(p); }
}
static void bitmap_fill(unsigned long *word,unsigned bits)
{
    assert(bits==32);*word=(~0UL)>>(sizeof(unsigned long)*CHAR_BIT-bits);
}
#define malloc(size,type,flags) host_idr_alloc((size),(flags))
#define free(p,type) host_idr_free(p)
