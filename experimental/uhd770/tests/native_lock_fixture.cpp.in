static void exclusive_sleep_recursion()
{
    sx s{};sx_init_flags(&s,"sx-recursive",SX_RECURSE);
    nmx_sx_xlock(&s);require(nmx_sx_try_xlock(&s) && s.sx_recurse==1,"SX recursive acquisition failed");
    uintptr_t how=nmx_lock_release(&s.lock_object);
    require(how==1 && !nmx_sx_owner(&s),"SX sleep release did not drop recursion and native ownership");
    std::thread sxwriter([&] { nmx_sx_xlock(&s);nmx_sx_xunlock(&s); });sxwriter.join();
    nmx_lock_reacquire(&s.lock_object,how);
    require(nmx_sx_xlocked(&s) && s.sx_recurse==1,"SX sleep reacquire lost recursive ownership");
    nmx_sx_xunlock(&s);require(nmx_sx_xlocked(&s),"SX recursive unlock released native lock too early");nmx_sx_xunlock(&s);sx_destroy(&s);
    rwlock rw{};rw_init_flags(&rw,"rw-recursive",RW_RECURSE);
    nmx_rw_wlock(&rw);require(nmx_rw_try_wlock(&rw) && rw.rw_recurse==1,"RW recursive acquisition failed");
    how=nmx_lock_release(&rw.lock_object);require(how==1 && !nmx_rw_owner(&rw),"RW sleep release lost recursion mode");
    std::thread rwwriter([&] { nmx_rw_wlock(&rw);nmx_rw_wunlock(&rw); });rwwriter.join();
    nmx_lock_reacquire(&rw.lock_object,how);
    require(nmx_rw_wowned(&rw) && rw.rw_recurse==1,"RW sleep reacquire did not restore depth");
    nmx_rw_wunlock(&rw);require(nmx_rw_wowned(&rw),"RW recursive unlock released early");nmx_rw_wunlock(&rw);rw_destroy(&rw);
