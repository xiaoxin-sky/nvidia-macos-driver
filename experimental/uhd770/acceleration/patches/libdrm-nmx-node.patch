+static int drm_darwin_open_node(int maj, int min)
+{
+    char path[PATH_MAX];
+    if (drm_darwin_node_path(maj, min, path, sizeof(path)) < 0)
+        return -1;
+    return open(path, O_RDWR | O_CLOEXEC);
+}
+
+/* Query the file's DRM identity rather than fstat's per-open XNU clone ID.
+ * Return libc-style -1/errno. Reject unknown node kinds without guessing. */
+static int drm_darwin_fd_node(int fd, struct nmx_drm_node_info *info)
+{
+    struct stat st;
+    if (fstat(fd, &st))
+        return -1;
+    if (!S_ISCHR(st.st_mode)) {
+        errno = EINVAL;
+        return -1;
+    }
+    memset(info, 0, sizeof(*info));
+    if (drmIoctl(fd, NMX_DRM_IOCTL_NODE_INFO, info))
+        return -1;
+    if ((info->type != NMX_DRM_NODE_PRIMARY && info->type != NMX_DRM_NODE_RENDER) ||
+        info->index > INT_MAX) {
+        errno = ENODEV;
+        return -1;
+    }
+    return 0;
 }
