+#ifdef __APPLE__
+/* XNU xnu-11417.140.69 devfs_dntovn creates a fresh clone on every lookup,
+ * including stat. Node numbers must come from NODE_INFO on an opened fd.
+ * PCIINFO supplies both the bus location and hardware IDs; names only select
+ * a candidate and must agree exactly with that fd's logical node identity. */
+static int drm_darwin_fd_path(const struct nmx_drm_node_info *info,
+                              char *path, size_t capacity)
+{
+    int n = snprintf(path, capacity, "%s/%s%u", DRM_DIR_NAME,
+                     info->type == NMX_DRM_NODE_RENDER ? "renderD" : "card", info->index);
+    return n < 0 || (size_t)n >= capacity ? -ENAMETOOLONG : 0;
+}
+
+static bool drm_darwin_pci_equal(const struct drm_pciinfo *a, const struct drm_pciinfo *b)
+{
+    return a->domain == b->domain && a->bus == b->bus && a->dev == b->dev && a->func == b->func &&
+           a->vendor_id == b->vendor_id && a->device_id == b->device_id &&
+           a->subvendor_id == b->subvendor_id && a->subdevice_id == b->subdevice_id &&
+           a->revision_id == b->revision_id;
+}
+
+static int drm_darwin_query_node(const char *path, struct nmx_drm_node_info *info,
+                                  struct drm_pciinfo *pci)
+{
+    char actual[PATH_MAX];
+    const char *stage = "open";
+    int ret = 0;
+    int fd = open(path, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    memset(info, 0, sizeof(*info));
+    memset(pci, 0, sizeof(*pci));
+    if (fd < 0) {
+        ret = -errno;
+        goto out;
+    }
+    stage = "NODE_INFO";
+    if (drm_darwin_fd_node(fd, info)) {
+        ret = -errno;
+        goto close_fd;
+    }
+    stage = "logical-name";
+    ret = drm_darwin_fd_path(info, actual, sizeof(actual));
+    if (ret)
+        goto close_fd;
+    if (strcmp(path, actual)) {
+        ret = -ENODEV;
+        goto close_fd;
+    }
+    stage = "PCIINFO";
+    if (drmIoctl(fd, DRM_IOCTL_GET_PCIINFO, pci))
+        ret = -errno;
+close_fd:
+    close(fd);
+out:
+    if (getenv("NMX_DRM_DEBUG"))
+        fprintf(stderr, "NMX DRM discovery path=%s stage=%s result=%d type=%u index=%u "
+                "bdf=%04x:%02x:%02x.%u pci=%04x:%04x\n", path, stage, ret, info->type, info->index,
+                pci->domain, pci->bus, pci->dev, pci->func, pci->vendor_id, pci->device_id);
+    return ret;
+}
+
+/* Construct one node using a single open/query/close transaction. No access,
+ * stat, devname or sysfs lookup is used, and errors cannot leak a descriptor.
+ * The caller folds peers by PCI location after both were individually checked. */
+static int drm_darwin_process_device(drmDevicePtr *device, const char *name,
+                                      int requested_bus, bool fetch_info, uint32_t flags)
+{
+    struct nmx_drm_node_info info;
+    struct drm_pciinfo pci;
+    char node[PATH_MAX + 1] = "", *tail, *addr;
+    int type = drmGetNodeType(name);
+    unsigned long index;
+    int ret, written;
+    drmDevicePtr d;
+    if (type < 0 || (requested_bus != -1 && requested_bus != DRM_BUS_PCI))
+        return -ENODEV;
+    const char *digits = name + (type == DRM_NODE_RENDER ? strlen("renderD") : strlen("card"));
+    if (!*digits || strspn(digits, "0123456789") != strlen(digits) ||
+        (digits[0] == '0' && digits[1]))
+        return -ENODEV;
+    errno = 0;
+    index = strtoul(digits, &tail, 10);
+    if (errno || *tail || index > 999)
+        return -ENODEV;
+    written = snprintf(node, sizeof(node), "%s/%s", DRM_DIR_NAME, name);
+    if (written < 0 || (size_t)written >= sizeof(node) || written + 1 > drmGetMaxNodeName())
+        return -ENAMETOOLONG;
+    ret = drm_darwin_query_node(node, &info, &pci);
+    if (ret)
+        return ret;
+    d = drmDeviceAlloc(type, node, sizeof(drmPciBusInfo), sizeof(drmPciDeviceInfo), &addr);
+    if (!d)
+        return -ENOMEM;
+    d->bustype = DRM_BUS_PCI;
+    d->businfo.pci = (drmPciBusInfoPtr)addr;
+    d->businfo.pci->domain = pci.domain;
+    d->businfo.pci->bus = pci.bus;
+    d->businfo.pci->dev = pci.dev;
+    d->businfo.pci->func = pci.func;
+    if (fetch_info) {
+        d->deviceinfo.pci = (drmPciDeviceInfoPtr)(addr + sizeof(drmPciBusInfo));
+        d->deviceinfo.pci->vendor_id = pci.vendor_id;
+        d->deviceinfo.pci->device_id = pci.device_id;
+        d->deviceinfo.pci->subvendor_id = pci.subvendor_id;
+        d->deviceinfo.pci->subdevice_id = pci.subdevice_id;
+        d->deviceinfo.pci->revision_id = pci.revision_id;
+    }
+    (void)flags; /* PCIINFO returns revision even when it was not requested. */
+    *device = d;
+    return 0;
+}
