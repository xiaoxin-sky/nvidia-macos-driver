@@ -5554,6 +5558,110 @@ drmGetFormatName(uint32_t format)
 #ifdef __APPLE__
 #include <pthread.h>
 #include <sys/ioctl.h>
+#include <IOKit/IOKitLib.h>
+
+/*
+ * WindowServer's sandbox lets it open a DRM node read-only, but every ioctl on a device file fails with EPERM (UHD 770
+ * plan step F, r39). NMXGPU offers the same node through an IOKit user client (IOAccelNMXDRMClient, which that sandbox
+ * allows): on EPERM the fd is switched to one, and every ioctl on it goes there from then on, so all its state (GEM
+ * handles, VMs, mappings) lives in one DRM file. The fd stays a real open of the node, for fstat() and device
+ * identification. A client is matched to its fd by the fd's device number: every open of a NullMoth node is its own
+ * clone minor, so a reused fd number never inherits another file's client.
+ */
+struct nmx_uc {
+    int fd;
+    dev_t rdev;
+    io_connect_t conn;
+    struct nmx_uc *next;
+};
+static struct nmx_uc *nmx_ucs;
+static pthread_mutex_t nmx_ucs_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static io_connect_t nmx_uc_get(int fd, int create)
+{
+    struct stat st;
+    struct nmx_uc *u, **pp;
+    io_connect_t conn = 0;
+
+    if (fstat(fd, &st) != 0 || !S_ISCHR(st.st_mode))
+        return 0;
+    pthread_mutex_lock(&nmx_ucs_lock);
+    for (pp = &nmx_ucs; (u = *pp) != NULL; pp = &u->next) {
+        if (u->fd != fd)
+            continue;
+        if (u->rdev == st.st_rdev) {
+            conn = u->conn;
+            break;
+        }
+        /* the fd number now names another open: its old client is stale */
+        *pp = u->next;
+        IOServiceClose(u->conn);
+        free(u);
+        break;
+    }
+    if (!conn && create) {
+        io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NMXGPU"));
+        if (svc) {
+            if (IOServiceOpen(svc, mach_task_self(), 'NMXD', &conn) != KERN_SUCCESS)
+                conn = 0;
+            IOObjectRelease(svc);
+        }
+        if (conn && (u = malloc(sizeof(*u))) != NULL) {
+            u->fd = fd;
+            u->rdev = st.st_rdev;
+            u->conn = conn;
+            u->next = nmx_ucs;
+            nmx_ucs = u;
+        } else if (conn) {
+            IOServiceClose(conn);
+            conn = 0;
+        }
+    }
+    pthread_mutex_unlock(&nmx_ucs_lock);
+    return conn;
+}
+
+/* NMX_DRM_IOKIT=1 sends every ioctl through the IOKit client from the first one, so an unsandboxed test exercises
+ * WindowServer's transport (UHD 770 plan step F, r41) */
+static int nmx_uc_forced(void)
+{
+    static int forced = -1;
+    if (forced < 0) {
+        const char *e = getenv("NMX_DRM_IOKIT");
+        forced = e && !strcmp(e, "1");
+    }
+    return forced;
+}
+
+drm_public int drmNmxIoctl(int fd, unsigned long request, void *arg)
+{
+    io_connect_t conn = nmx_uc_get(fd, nmx_uc_forced());
+    if (!conn) {
+        int ret = ioctl(fd, request, arg);
+        if (ret == 0 || errno != EPERM)
+            return ret;
+        conn = nmx_uc_get(fd, 1);
+        if (!conn) {
+            errno = EPERM;
+            return -1;
+        }
+    }
+    uint64_t cmd = request, err = 0;
+    uint32_t nout = 1;
+    size_t len = IOCPARM_LEN(request), outlen = (request & IOC_OUT) ? len : 0;
+    kern_return_t kr = IOConnectCallMethod(conn, 0, &cmd, 1, (request & IOC_IN) ? arg : NULL,
+                                           (request & IOC_IN) ? len : 0, &err, &nout,
+                                           (request & IOC_OUT) ? arg : NULL, &outlen);
+    if (kr != KERN_SUCCESS) {
+        errno = EIO;
+        return -1;
+    }
+    if (err) {
+        errno = (int)err;
+        return -1;
+    }
+    return 0;
+}
 
