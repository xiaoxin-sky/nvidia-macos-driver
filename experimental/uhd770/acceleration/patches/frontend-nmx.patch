+    /* AMD/Intel (NMXAccel): app-only unless the accelerator was armed with its own framebuffer (UHD 770 plan step F) */
+    if (h < 0 && nvmtl_vk_vendor() != 0x10de) {
+        int v = 1; size_t n = sizeof v;
+        h = sysctlbyname("debug.nmxaccel_headless", &v, &n, NULL, 0) != 0 || v;
+        nvlog(h ? "AMD/Intel GPU: IOSurfaces are copied out to system memory" : "AMD/Intel GPU drives the display: armed accelerator");
+    }
     if (h < 0) { int v = 0; size_t n = sizeof v; h = sysctlbyname("debug.nvaccel_headless", &v, &n, NULL, 0) == 0 && v;
                  if (h) nvlog("headless GPU: the display belongs to another GPU - IOSurfaces are copied out to system memory"); }
     return h;
