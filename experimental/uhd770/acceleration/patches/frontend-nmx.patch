     // on the GPU that owns the display, as on Apple's two-GPU Macs. The list below cannot express this: "*" matches
     // WindowServer before its "!WindowServer" line is reached.
-    { int hv = 0; size_t hn = sizeof hv;
-      if (!strcmp(me, "WindowServer") && (nvmtl_vk_vendor() != 0x10de ||
-                                          (sysctlbyname("debug.nvaccel_headless", &hv, &hn, NULL, 0) == 0 && hv))) {
-          nvlog("  headless GPU: no device for WindowServer (it composites on the GPU that owns the display)"); return false; } }
+    // AMD/Intel (NMXAccel) stays headless unless its accelerator was armed with its own framebuffer
+    // (debug.nmxaccelfb, UHD 770 plan step F; the reference Meteor Lake port reads the same sysctl): then
+    // WindowServer composites here, as "!WindowServer" (armed-only) would allow.
+    if (!strcmp(me, "WindowServer")) {
+        int hv = 0; size_t hn = sizeof hv;
+        if (nvmtl_vk_vendor() != 0x10de) {
+            if (sysctlbyname("debug.nmxaccel_headless", &hv, &hn, NULL, 0) != 0 || hv) {
+                nvlog("  headless GPU: no device for WindowServer (it composites on the GPU that owns the display)"); return false; }
+            nvlog("  armed AMD/Intel accelerator: a device for WindowServer");
+            return true;
+        }
+        if (sysctlbyname("debug.nvaccel_headless", &hv, &hn, NULL, 0) == 0 && hv) {
+            nvlog("  headless GPU: no device for WindowServer (it composites on the GPU that owns the display)"); return false; }
+    }
