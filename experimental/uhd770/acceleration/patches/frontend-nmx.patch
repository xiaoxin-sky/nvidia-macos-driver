+    /* Intel WindowServer: the display pipe copies its frames with the CPU, which reads compressed (CCS) surfaces as
+       garbage. The reference Meteor Lake port sets this too; ANV parses INTEL_DEBUG once, so before it loads. */
+    if (nvmtl_vk_vendor() == 0x8086 && getprogname() && !strcmp(getprogname(), "WindowServer")) {
+        const char *was = getenv("INTEL_DEBUG");
+        char flags[512];
+        int n = snprintf(flags, sizeof flags, "%s%snoccs", was ? was : "", was && *was ? "," : "");
+        if (n > 0 && (size_t)n < sizeof flags && setenv("INTEL_DEBUG", flags, 1) == 0)
+            nvlog("vk: WindowServer on Intel: INTEL_DEBUG=%s", flags);
+        else nvlog("vk: WindowServer on Intel: could not add noccs to INTEL_DEBUG");
+    }
     g_lib = dlopen(NVMTL_ICD_LIB, RTLD_NOW | RTLD_LOCAL);
     if (g_lib) {
         pvkGetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)dlsym(g_lib, "vkGetInstanceProcAddr");
@@ -1834,8 +1844,12 @@ static int nvmtl_vk_image_create_typed_lifetime_body(uint32_t w, uint32_t h, uin
 static int nvmtl_gpu_headless(void)
 {
     static int h = -1;
-    /* AMD/Intel (NMXAccel): WindowServer draws into NMXGPU's framebuffer, so this device is always an app-only GPU */
