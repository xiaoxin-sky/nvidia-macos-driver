@@ -284,8 +298,16 @@
 
    if (likely(device->physical->info.has_mmap_offset))
       return i915_gem_mmap_offset(device, bo, offset, size, flags, placed_addr);
+#ifdef __APPLE__
+   /* This NMX kernel deliberately does not implement the legacy shmem ioctl.
