new file mode 100644
--- /dev/null
+++ b/src/intel/vulkan/anv_nmx_mmap.h
@@ -0,0 +1,118 @@
+/*
+ * Copyright (C) 2026 Intel macOS experimental port contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Exact-range BO mappings for the x86_64 NMX DRM node. Darwin character
+ * devices cannot provide mmap(2); the kernel owns each complete mapping until
+ * its matching unmap ioctl or DRM-fd close. Keep these copied ABI structures
+ * and commands synchronized with xkpi/bsdcompat/include/nmx_drm_uapi.h.
+ *
+ * The caller supplies Intel's ioctl transport. This helper never handles
+ * anonymous/host mappings or PRIME fds, and never splits one kernel mapping
+ * into aliases that could outlive its pin. Placed/reserved mappings require
+ * additional lifetime support and are deliberately unavailable in this MVP.
+ */
+#ifndef ANV_NMX_MMAP_H
+#define ANV_NMX_MMAP_H
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+
+struct anv_nmx_drm_mmap {
+   uint64_t offset;
+   uint64_t size;
+   uint32_t prot;
+   uint32_t flags;
+   uint64_t addr;
+};
+
+struct anv_nmx_drm_munmap {
+   uint64_t addr;
+   uint64_t size;
+};
+
+_Static_assert(sizeof(struct anv_nmx_drm_mmap) == 32, "NMX mmap ABI size");
+_Static_assert(sizeof(struct anv_nmx_drm_munmap) == 16, "NMX munmap ABI size");
+
+#define ANV_NMX_DRM_IOCTL_MMAP \
+   _IOWR('N', 0x40, struct anv_nmx_drm_mmap)
+#define ANV_NMX_DRM_IOCTL_MUNMAP \
+   _IOW('N', 0x41, struct anv_nmx_drm_munmap)
+#define ANV_NMX_PAGE_SIZE UINT64_C(4096)
+#define ANV_NMX_MAX_MAP_SIZE (UINT64_C(1) << 40)
+
+typedef int (*anv_nmx_ioctl_fn)(int fd, unsigned long command, void *argument);
+
+/*
+ * Map a page-aligned slice of a GEM object at its fake offset. Unlike ANV's
+ * Linux overmap-and-trim path, offset is added to the DRM offset before the
+ * request: the returned address and size always describe one complete NMX
+ * mapping. The existing i915 VMA lookup/fault path validates the object bounds.
+ */
+static inline void *
+anv_nmx_bo_mmap(int fd, uint64_t fake_offset, uint64_t offset, uint64_t size,
+                 void *placed_addr, anv_nmx_ioctl_fn invoke)
+{
+   if (placed_addr != NULL) {
+      errno = EOPNOTSUPP;
+      return MAP_FAILED;
+   }
+   if (size == 0 || size > ANV_NMX_MAX_MAP_SIZE ||
+       (fake_offset & (ANV_NMX_PAGE_SIZE - 1)) != 0 ||
+       (offset & (ANV_NMX_PAGE_SIZE - 1)) != 0 ||
+       offset > UINT64_MAX - fake_offset) {
+      errno = EINVAL;
+      return MAP_FAILED;
+   }
+
+   const uint64_t request_offset = fake_offset + offset;
+   const uint64_t rounded_size =
+      (size + ANV_NMX_PAGE_SIZE - 1) & ~(ANV_NMX_PAGE_SIZE - 1);
+   if (rounded_size > UINT64_MAX - request_offset) {
+      errno = EINVAL;
+      return MAP_FAILED;
+   }
+
+   struct anv_nmx_drm_mmap request = {
+      .offset = request_offset,
+      .size = size,
+      .prot = PROT_READ | PROT_WRITE,
+   };
+   if (invoke(fd, ANV_NMX_DRM_IOCTL_MMAP, &request) != 0)
+      return MAP_FAILED;
+
+   return (void *)(uintptr_t)request.addr;
+}
+
+/*
+ * Release the exact page-rounded slice returned by anv_nmx_bo_mmap through
+ * the same still-open DRM fd. A failed ioctl leaves ownership in the kernel;
+ * it must not be hidden by a libc munmap fallback or forgotten user record.
+ */
+static inline int
+anv_nmx_bo_munmap(int fd, void *address, uint64_t size, bool replace,
+                   anv_nmx_ioctl_fn invoke)
+{
+   if (replace) {
+      errno = EOPNOTSUPP;
+      return -1;
+   }
+   if (address == NULL || address == MAP_FAILED ||
+       ((uintptr_t)address & (ANV_NMX_PAGE_SIZE - 1)) != 0 ||
+       size == 0 || size > ANV_NMX_MAX_MAP_SIZE) {
+      errno = EINVAL;
+      return -1;
+   }
+
+   struct anv_nmx_drm_munmap request = {
+      .addr = (uint64_t)(uintptr_t)address,
+      .size = size,
+   };
+   return invoke(fd, ANV_NMX_DRM_IOCTL_MUNMAP, &request);
+}
+
+#endif
