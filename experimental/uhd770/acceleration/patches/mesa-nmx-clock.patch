diff --git a/src/util/u_nmx_sync_clock.h b/src/util/u_nmx_sync_clock.h
new file mode 100644
--- /dev/null
+++ b/src/util/u_nmx_sync_clock.h
@@ -0,0 +1,68 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * NMX's Darwin DRM ioctls interpret absolute wait deadlines in mach uptime
+ * nanoseconds. Mesa's public/runtime deadlines remain CLOCK_MONOTONIC, as do
+ * its condition variables. Translate only at the explicitly selected NMX
+ * sync-provider boundary; never change the global userspace clock epoch.
+ */
+#ifndef U_NMX_SYNC_CLOCK_H
+#define U_NMX_SYNC_CLOCK_H
+
+#include <errno.h>
+#include <stdint.h>
+#include <time.h>
+
+static inline int
+util_nmx_timespec_ns(const struct timespec *time, int64_t *nanoseconds)
+{
+   const int64_t scale = INT64_C(1000000000);
+   if (time->tv_sec < 0 || time->tv_nsec < 0 || time->tv_nsec >= scale ||
+       (uint64_t)time->tv_sec > (uint64_t)INT64_MAX / (uint64_t)scale ||
+       ((uint64_t)time->tv_sec == (uint64_t)INT64_MAX / (uint64_t)scale &&
+        time->tv_nsec > INT64_MAX % scale)) {
+      errno = EOVERFLOW;
+      return -1;
+   }
+   *nanoseconds = (int64_t)time->tv_sec * scale + time->tv_nsec;
+   return 0;
+}
+
+/* Preserve the remaining duration, polling and the infinite-timeout sentinel.
+ * Sampling uptime after monotonic can add only the local sampling interval;
+ * it cannot make a finite wait inherit a historical wall/uptime epoch offset.
+ * Clock failures are returned, never converted into an infinite wait.
+ */
+static inline int
+util_nmx_sync_abs_timeout(int64_t monotonic_deadline, int64_t *uptime_deadline)
+{
+   if (monotonic_deadline <= 0 || monotonic_deadline == INT64_MAX) {
+      *uptime_deadline = monotonic_deadline <= 0 ? 0 : INT64_MAX;
+      return 0;
+   }
+
+   struct timespec monotonic, uptime;
+   if (clock_gettime(CLOCK_MONOTONIC, &monotonic) != 0 ||
+       clock_gettime(CLOCK_UPTIME_RAW, &uptime) != 0)
+      return -1;
+
+   int64_t monotonic_now, uptime_now;
+   if (util_nmx_timespec_ns(&monotonic, &monotonic_now) != 0 ||
+       util_nmx_timespec_ns(&uptime, &uptime_now) != 0)
+      return -1;
+
+   if (monotonic_deadline <= monotonic_now) {
+      *uptime_deadline = 0;
+      return 0;
+   }
+
+   const int64_t remaining = monotonic_deadline - monotonic_now;
+   if (remaining > INT64_MAX - uptime_now) {
+      errno = EOVERFLOW;
+      return -1;
+   }
+   *uptime_deadline = uptime_now + remaining;
+   return 0;
+}
+
+#endif
