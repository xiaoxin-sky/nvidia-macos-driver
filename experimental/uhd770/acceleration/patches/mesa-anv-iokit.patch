diff --git a/src/intel/common/intel_gem.h b/src/intel/common/intel_gem.h
--- a/src/intel/common/intel_gem.h
+++ b/src/intel/common/intel_gem.h
@@ -75,6 +75,24 @@ intel_48b_address(uint64_t v)
 extern int intel_virtio_ioctl(int fd, unsigned long request, void *arg);
 #endif
 
+#ifdef __APPLE__
+#include <dlfcn.h>
+/* WindowServer's sandbox denies ioctls on /dev/dri; libdrm's drmNmxIoctl then reaches the node through NMXGPU's IOKit
+ * user client (UHD 770 plan step F, r40). Looked up at run time: not everything that includes this header links
+ * libdrm. */
+static inline int
+intel_nmx_ioctl(int fd, unsigned long request, void *arg)
+{
+   static int (*volatile fn)(int, unsigned long, void *);
+   static volatile int looked;
+   if (!looked) {
+      fn = (int (*)(int, unsigned long, void *))dlsym(RTLD_DEFAULT, "drmNmxIoctl");
+      looked = 1;
+   }
+   return fn ? fn(fd, request, arg) : ioctl(fd, request, arg);
+}
+#endif
+
 /**
  * Call ioctl, restarting if it is interrupted
  */
@@ -86,6 +104,8 @@ intel_ioctl(int fd, unsigned long request, void *arg)
     do {
 #ifdef HAVE_INTEL_VIRTIO
       ret = intel_virtio_ioctl(fd, request, arg);
+#elif defined(__APPLE__)
+      ret = intel_nmx_ioctl(fd, request, arg);
 #else
       ret = ioctl(fd, request, arg);
 #endif
