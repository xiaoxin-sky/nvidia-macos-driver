diff --git a/src/util/os_drm.h b/src/util/os_drm.h
--- a/src/util/os_drm.h
+++ b/src/util/os_drm.h
@@ -18,13 +18,35 @@
 #include <errno.h>
 #include <xf86drm.h>
 
+#ifdef __APPLE__
+#include <dlfcn.h>
+/* WindowServer's sandbox denies ioctls on /dev/dri; libdrm's drmNmxIoctl then reaches the node through NMXGPU's IOKit
+ * user client (UHD 770 plan step F, r40). Looked up at run time: not everything that includes this header links
+ * libdrm. */
+static inline int
+os_drm_nmx_ioctl(int fd, unsigned long request, void *arg)
+{
+   static int (*volatile fn)(int, unsigned long, void *);
+   static volatile int looked;
+   if (!looked) {
+      fn = (int (*)(int, unsigned long, void *))dlsym(RTLD_DEFAULT, "drmNmxIoctl");
+      looked = 1;
+   }
+   return fn ? fn(fd, request, arg) : ioctl(fd, request, arg);
+}
+#endif
+
 static inline int
 drm_ioctl(int fd, uint32_t request, void *arg)
 {
    int ret;
 
    do {
+#ifdef __APPLE__
+      ret = os_drm_nmx_ioctl(fd, request, arg);
+#else
       ret = ioctl(fd, request, arg);
+#endif
    } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
 
    return ret ? -errno : 0;
